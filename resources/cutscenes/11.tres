[gd_resource type="Resource" script_class="CutsceneScript" load_steps=17 format=3 uid="uid://cwkx3ckwlsyc8"]

[ext_resource type="Script" uid="uid://c7505rjkk6rpg" path="res://resources/data_structures/cutscene_script.gd" id="1_jc8h0"]
[ext_resource type="Script" uid="uid://b2sxig6otw26p" path="res://resources/data_structures/cutscene_step.gd" id="2_gte0w"]

[sub_resource type="Resource" id="Resource_jc8h0"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "太陽...變得更近了"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_gte0w"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "這個世界...會變得怎麼樣呢?
"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_w4myd"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "啊......到阿爾夫海姆了。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_wfnab"]
script = ExtResource("2_gte0w")
speaker = "魯德拉布(兄)"
text = "哥布林……居然能走到這裡。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_l0lpd"]
script = ExtResource("2_gte0w")
speaker = "魯德拉布(兄)"
text = "你很有名呢，殺人不眨眼的怪物。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_b24go"]
script = ExtResource("2_gte0w")
speaker = "雷德歐（弟）"
text = "一起殺了他吧，兄長大人。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_4kjjg"]
script = ExtResource("2_gte0w")
speaker = "魯德拉布(兄)"
text = "你知道自己殺了多少人嗎！"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_mgwpm"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "你們也殺了很多哥布林。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_k8qjp"]
script = ExtResource("2_gte0w")
speaker = "雷德歐(弟)"
text = "那種怪物也算生命？"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_glndd"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "......"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_u6k56"]
script = ExtResource("2_gte0w")
speaker = "魯德拉布(兄)"
text = "上吧弟弟，身為被選上的勇者，我們要保護這個世界。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_ojkc7"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "這個世界……已經快死了。"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_e8tkx"]
script = ExtResource("2_gte0w")
speaker = "雷德歐（弟）"
text = "只要你死了，一切都會結束！"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_hdmsi"]
script = ExtResource("2_gte0w")
speaker = "維利夫"
text = "......"
metadata/_custom_type_script = "uid://b2sxig6otw26p"

