[gd_resource type="Resource" script_class="StageCollection" load_steps=13 format=3]

[ext_resource type="Script" path="res://resources/data_structures/stage_data.gd" id="1_stage_data"]
[ext_resource type="Script" path="res://resources/data_structures/stage_collection.gd" id="2_stage_collection"]

[sub_resource type="Resource" id="Resource_startup"]
script = ExtResource("1_stage_data")
id = "universal_startup"
name = "通用啟動"
req_exp = 0
cutscene_id = "startup_intro"
unlocks_memory_id = "mem_startup"

[sub_resource type="Resource" id="Resource_early"]
script = ExtResource("1_stage_data")
id = "early_milestone"
name = "早期里程碑"
req_exp = 10
cutscene_id = "early_milestone_cutscene"
unlocks_memory_id = ""

[sub_resource type="Resource" id="Resource_mini_level"]
script = ExtResource("1_stage_data")
id = "trial_mini_level"
name = "微型關卡"
req_exp = 100
cutscene_id = "mini_level"
unlocks_memory_id = "mem_mini_level"

[sub_resource type="Resource" id="Resource_open_world"]
script = ExtResource("1_stage_data")
id = "trial_open_world"
name = "開放世界"
req_exp = 200
cutscene_id = "open_world"
unlocks_memory_id = "mem_open_world"

[sub_resource type="Resource" id="Resource_first_village"]
script = ExtResource("1_stage_data")
id = "trial_first_village"
name = "第一個村莊"
req_exp = 300
cutscene_id = "first_village"
unlocks_memory_id = "mem_first_village"

[sub_resource type="Resource" id="Resource_get_map"]
script = ExtResource("1_stage_data")
id = "trial_get_map"
name = "獲得地圖"
req_exp = 400
cutscene_id = "get_map"
unlocks_memory_id = "mem_get_map"

[sub_resource type="Resource" id="Resource_goblin_capital"]
script = ExtResource("1_stage_data")
id = "trial_goblin_capital"
name = "哥布林主城"
req_exp = 500
cutscene_id = "goblin_capital"
unlocks_memory_id = "mem_goblin_capital"

[sub_resource type="Resource" id="Resource_human_territory"]
script = ExtResource("1_stage_data")
id = "trial_human_territory"
name = "人類領地"
req_exp = 600
cutscene_id = "human_territory"
unlocks_memory_id = "mem_human_territory"

[sub_resource type="Resource" id="Resource_human_capital"]
script = ExtResource("1_stage_data")
id = "trial_human_capital"
name = "人類主城"
req_exp = 700
cutscene_id = "human_capital"
unlocks_memory_id = "mem_human_capital"

[sub_resource type="Resource" id="Resource_ending"]
script = ExtResource("1_stage_data")
id = "trial_ending"
name = "試玩版結局"
req_exp = 800
cutscene_id = "ending_trial"
unlocks_memory_id = "mem_ending_trial"

[resource]
script = ExtResource("2_stage_collection")
stages = Array[ExtResource("1_stage_data")]([
	SubResource("Resource_startup"),
	SubResource("Resource_early"),
	SubResource("Resource_mini_level"),
	SubResource("Resource_open_world"),
	SubResource("Resource_first_village"),
	SubResource("Resource_get_map"),
	SubResource("Resource_goblin_capital"),
	SubResource("Resource_human_territory"),
	SubResource("Resource_human_capital"),
	SubResource("Resource_ending")
])
