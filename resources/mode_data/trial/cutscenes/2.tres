[sub_resource type="Resource" id="Resource_h5gef"]
script = ExtResource("2_step")
speaker = "村長"
text = "好久不見啊，已經長這麼大了。你妹妹沒有一起來嗎?"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_i50cu"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "格莉德死了..."
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_v3jpy"]
script = ExtResource("2_step")
speaker = "村長"
text = "!?"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_2hi1l"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "今天早上，村子被..."
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_s2i6h"]
script = ExtResource("2_step")
type = 2
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_cd7rp"]
script = ExtResource("2_step")
speaker = " 村長"
text = "可惡，人族已經入侵並在各地紮營了嗎。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_sra4q"]
script = ExtResource("2_step")
speaker = "村長"
text = "我們明天會遷村。維利夫，你也一起來吧。
"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_webor"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "不了，我要復仇。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_hcc1h"]
script = ExtResource("2_step")
speaker = "村長"
text = "......不行，那不是你一個人能背負的東西，仇恨會把你吃掉。
"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_rg2hp"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "隨便。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_76ibb"]
script = ExtResource("2_step")
speaker = "村長"
text = "你會死！
"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_0w0d8"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "在殺光他們以前，
我不會死。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_wqdki"]
script = ExtResource("2_step")
speaker = "村長"
text = "......好吧，我不會阻止你。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_xnl78"]
script = ExtResource("2_step")
speaker = "村長"
text = "但身為村長，我有義務保護大家，所以我不會將遷村的位置告訴可能成為突破口的你。
"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_5ryvc"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "嗯，這樣就夠了。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_17vok"]
script = ExtResource("2_step")
speaker = "村長"
text = "這個給你，前往穆斯貝爾海姆吧。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_b1h4u"]
