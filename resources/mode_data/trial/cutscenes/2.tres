[sub_resource type="Resource" id="Resource_wf175"]
script = ExtResource("2_step")
speaker = "維利夫"
text = "謝謝。"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

[sub_resource type="Resource" id="Resource_x7q6k"]
script = ExtResource("2_step")
speaker = "村長"
text = "那就再見了，之後有緣再見面吧。
"
texture = ExtResource("3_i50cu")
metadata/_custom_type_script = "uid://b2sxig6otw26p"

